# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_MAX=5

# Server / authentication
API_PORT=4000
ADMIN_NAME=Diamond Mine Africa
ADMIN_PASSWORD=change-this-to-a-long-random-password
SESSION_COOKIE_NAME=dma_session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false

# Public app origin / CORS. Keep empty for same-origin Vercel deployment.
APP_ORIGIN=
APP_TIMEZONE=Africa/Addis_Ababa
CORS_ORIGINS=

# Payment destination shown to authenticated users by /api/payment-config.
# Do NOT put these values in VITE_* variables or source code.
CBE_ACCOUNT_NUMBER=
CBE_ACCOUNT_NAME=
CBE_BRANCH=Commercial Bank of Ethiopia


# Optional local receipt storage override. On Vercel, connect a Vercel Blob store instead.
# RECEIPT_STORAGE=vercel_blob
# BLOB_READ_WRITE_TOKEN=only needed when your local Blob setup does not use Vercel OIDC
